rules_version = '2';

// Storage rules for tosijs-platform
//
// Role-based access is enforced via Firebase Auth custom claims.
// Custom claims are synced from Firestore roles when users make authenticated requests.
//
// For custom claims to be available, users must have made at least one
// authenticated API request (e.g., to /doc or /docs) after being assigned a role.
// This triggers the syncRolesToCustomClaims function in utilities.ts.

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user has any of the specified roles
    function hasRole(role) {
      return request.auth != null
        && request.auth.token.roles != null
        && role in request.auth.token.roles;
    }

    // Helper function to check if user has any content creation role
    function canCreateContent() {
      return hasRole('author')
        || hasRole('editor')
        || hasRole('admin')
        || hasRole('developer')
        || hasRole('owner');
    }

    // Blog assets - only content creators can write
    match /blog/{path=**} {
      allow read: if true;
      allow write: if canCreateContent();
    }

    // Public assets - only admins/developers can write
    match /public/{path=**} {
      allow read: if true;
      allow write: if hasRole('admin') || hasRole('developer') || hasRole('owner');
    }

    // User uploads - users can write to their own folder
    match /users/{userId}/{path=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default: public read, no write — EXCEPT storage areas. /blob keeps their
    // objects under "<namespace>:<area>/…"; their access rules live in the
    // area's manifest and are enforced only by /blob (which uses the Admin SDK
    // and bypasses these rules). Rules only ever GRANT, and a read is allowed
    // if any matching rule allows it — so this default must exclude a
    // namespaced first segment itself, or anyone could list and download a
    // PRIVATE area directly (0.3.0 review B2).
    //
    // Why a test on the FIRST segment is enough: the Storage API refuses a
    // list prefix that is non-empty and does not end in "/", so a listing
    // cannot straddle a namespaced folder — except the ROOT listing (empty
    // prefix), which is recursive and would name every object, private areas
    // included. So top-level files may be fetched, and the root may not be
    // listed (0.3.0 re-review G2).
    match /{first}/{rest=**} {
      allow read: if !first.matches('.*:.*');
      allow write: if false;
    }
    match /{file} {
      allow get: if !file.matches('.*:.*');
      allow write: if false;
    }
  }
}
