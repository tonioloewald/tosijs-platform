{
  "manifest": 1,
  "name": "blog",
  "version": "1.0.0",
  "description": "The blog's storage areas (board #1136 step 3): public files anyone may read, and private files only its writers see. The blog's own collections move here when tosijs-blog does.",
  "collections": {
    "blog:public": {
      "blob": {
        "maxBytes": 26214400,
        "contentTypes": ["image/*", "video/*", "audio/*", "application/pdf", "application/json", "text/plain"]
      },
      "access": [
        { "role": "public", "read": "ALL", "list": "ALL" },
        { "role": "author", "write": "ALL" },
        { "role": "editor", "write": "ALL" },
        { "role": "admin", "write": "ALL" },
        { "role": "developer", "write": "ALL" },
        { "role": "owner", "write": "ALL" }
      ]
    },
    "blog:private": {
      "blob": {
        "maxBytes": 26214400,
        "contentTypes": ["image/*", "video/*", "audio/*", "application/pdf", "application/json", "text/plain"]
      },
      "access": [
        { "role": "author", "read": "ALL", "list": "ALL", "write": "ALL" },
        { "role": "editor", "read": "ALL", "list": "ALL", "write": "ALL" },
        { "role": "admin", "read": "ALL", "list": "ALL", "write": "ALL" },
        { "role": "developer", "read": "ALL", "list": "ALL", "write": "ALL" },
        { "role": "owner", "read": "ALL", "list": "ALL", "write": "ALL" }
      ]
    }
  }
}
