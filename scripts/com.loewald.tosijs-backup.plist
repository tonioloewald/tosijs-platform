<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily backup of production Firestore (see scripts/backup-firestore.js).

  INSTALL (one time):
    cp scripts/com.loewald.tosijs-backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.loewald.tosijs-backup.plist

  CHECK:
    launchctl list | grep tosijs-backup
    tail ~/Backups/tosijs-platform/backup.log

  RUN IT NOW (without waiting for the schedule):
    launchctl start com.loewald.tosijs-backup

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.loewald.tosijs-backup.plist
    rm ~/Library/LaunchAgents/com.loewald.tosijs-backup.plist

  Notes:
   - Runs at 03:00 daily. RunAtLoad is false so installing it does not fire a run.
   - Keeps the newest 30 snapshots (~120MB at today's size).
   - Uses the REST transport via your existing gcloud login. If that login lapses
     the run exits non-zero and says so in backup.log — check the log occasionally,
     since launchd will not tell you.
   - PATH is set explicitly because launchd jobs do not inherit a login shell.
     Adjust if bun/gcloud live elsewhere (`which bun`, `which gcloud`).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.loewald.tosijs-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-lc</string>
        <string>cd /Users/tonioloewald/loewald-dot-com &amp;&amp; bun scripts/backup-firestore.js --quiet --keep 30</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/tonioloewald/.bun/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/tonioloewald/Backups/tosijs-platform/backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tonioloewald/Backups/tosijs-platform/backup.log</string>
</dict>
</plist>
