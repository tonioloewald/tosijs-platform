# Loaded by firebase-tools ONLY for deploys to the `sandbox` alias.
# D19: serve the platform's own collections (post, page, role, …) from
# system:registry instead of compiled TypeScript. Seed first:
#   bun scripts/seed-registry.js --alias sandbox --apply
PLATFORM_CONFIGS_FROM_REGISTRY=true

# Render on store (D23): serve stored values? false (default) | compare (engine=store for comparison only) | true
RENDER_ON_STORE=compare
